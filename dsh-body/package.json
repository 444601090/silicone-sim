{
  "name": "dsh-body",
  "version": "0.1.0",
  "description": "机体（dsh-body）：设置里的一页「机体」+ 宿主半边。管精力、体力、感受（时间/天气/温湿度），维护一个能自己睡、自己醒的生物钟状态，写 body/state.json 给思维和行为插件读。每 60 秒一拍，不烧模型。",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "body",
    "energy",
    "weather"
  ],
  "main": "lib/host.js",
  "exports": {
    ".": "./lib/host.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "client.js",
    "cordis.patch.yml",
    "DESIGN.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-plugins"
      ]
    }
  }
}
