{
  "name": "dsh-mind",
  "version": "0.1.0",
  "description": "思维中枢（dsh-mind）：设置里的一页「思维」+ 宿主半边。心情、好感、记忆索引统一成一个状态本，按确定性公式算出欲望（想聊天 / 想刷站 / 想睡觉 / 想发呆），供行为插件取用。每 60 秒一拍，不烧模型。",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "mind",
    "desire",
    "state"
  ],
  "main": "lib/host.js",
  "exports": {
    ".": "./lib/host.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "client.js",
    "cordis.patch.yml",
    "DESIGN.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-plugins"
      ]
    }
  }
}
