{
  "name": "dsh-simlife",
  "version": "0.1.0",
  "description": "模拟人生（dsh-simlife）：机体 + 思维 + 记忆 三合一 —— 激素/活性/耐力、感情/欲望/判断链、带权重的会淡忘的记忆，外加作用域切换。",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "body",
    "energy",
    "weather"
  ],
  "main": "lib/host.js",
  "exports": {
    ".": "./lib/host.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "client.js",
    "cordis.patch.yml",
    "DESIGN.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-plugins"
      ]
    }
  }
}
